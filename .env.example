# Kopiraj u .env.local. Za lokalni razvoj vrijednosti daje `npx supabase status -o env`
# (API_URL i PUBLISHABLE_KEY). Za oblak ih uzmi iz Supabase projekta.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Tajni ključ (service_role) za server: pravljenje računa korisnika i zaključavanje PIN prijave.
# Lokalno: SERVICE_ROLE_KEY iz `npx supabase status -o env`. U oblaku: Project Settings → API.
# NIKAD ne stavljati NEXT_PUBLIC_ ispred njega, niti ga dijeliti ili slati u git.
SUPABASE_SERVICE_ROLE_KEY=
